# Copy to .env.docker and replace every placeholder before deploying.
# Do not commit real values.

# SYSTUTOR CONFIGURATION
SYSTUTOR_ENV=production
SYSTUTOR_DEBUG=false
SYSTUTOR_VERSION=0.1.0
SYSTUTOR_API_PREFIX=/api/v1
SYSTUTOR_LOG_LEVEL=INFO
SYSTUTOR_OUTBOX_DISPATCH_BATCH_SIZE=100
SYSTUTOR_OUTBOX_MAX_RETRIES=3
SYSTUTOR_JWT_ACCESS_TOKEN_TTL_MINUTES=60
WORKERS=1
SYSTUTOR_SEED_TENANT_NAME=Demo Tenant
SYSTUTOR_SEED_TENANT_SLUG=demo
SYSTUTOR_SEED_BRANCH_NAME=Main Branch
SYSTUTOR_SEED_BRANCH_CODE=MAIN
SYSTUTOR_SEED_ADMIN_FULL_NAME=System Admin

# HOSTING / phpMyAdmin
# A.SPEC 0017: optional. The "Base de datos" button reveals the site's own
# database credential either way; this only enables the "Abrir phpMyAdmin"
# link. Use {server} only if phpMyAdmin runs with PMA_ARBITRARY=1; with a
# fixed PMA_HOST the base URL is used as-is.
# Example: http://127.0.0.1:8081/
SPANEL_PHPMYADMIN_URL=
# Internal-only URL reachable by the app container over a shared Docker network.
# The iframe uses the panel origin; no phpMyAdmin port needs publishing.
SPANEL_PHPMYADMIN_INTERNAL_URL=http://spanel-phpmyadmin:8080
SPANEL_PHPMYADMIN_SESSION_TTL=1500
SPANEL_PHPMYADMIN_TIMEOUT=15
# A.SPEC 0033: multi-database hub. Both must be active; with either off the
# login keeps sending no server (fixed PMA_HOST). ARBITRARY=true tells the
# panel to send pma_servername; DB_NETWORK is the internal network shared by
# phpMyAdmin and every site MariaDB (scripts/phpmyadmin_up.sh creates it).
SPANEL_PHPMYADMIN_ARBITRARY=false
SPANEL_PHPMYADMIN_DB_NETWORK=
# A.SPEC 0023: browsing root for the filemanager plugin on each owned
# WordPress container. It is server-side only; clients never choose a path.
SPANEL_HOSTING_FILES_ROOT=/var/www/html
# Static sites (nginx:alpine) have no PHP. The filemanager runs the same fixed
# PHP script in a disposable container that mounts the site's volumes. The
# image must contain PHP with ZipArchive; pre-pull it to avoid a slow first
# operation: docker pull wordpress:cli
SPANEL_FILEMANAGER_HELPER_IMAGE=wordpress:cli

# DATABASE
SYSTUTOR_DATABASE_URL=postgresql+psycopg://<db-user>:<db-password>@postgres:5432/<db-name>

# REDIS
SYSTUTOR_REDIS_URL=redis://redis:6379/0

# CORS
SYSTUTOR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT SECRET (generate a strong random string)
SYSTUTOR_JWT_SECRET_KEY=<replace-with-random-secret>

# SEED ADMIN (first user created automatically)
SYSTUTOR_SEED_ADMIN_EMAIL=<admin-email>
SYSTUTOR_SEED_ADMIN_PASSWORD=<admin-password>

# POSTGRES
POSTGRES_USER=<db-user>
POSTGRES_PASSWORD=<db-password>
POSTGRES_DB=<db-name>

# MAIL SERVER
MAIL_PROVIDER=docker-mailserver
MAIL_SERVER_HOST=<mail-server-host>
MAIL_SERVER_PORT=22
MAIL_SERVER_USER=<ssh-user>
MAIL_SERVER_PASSWORD=<ssh-password>
MAIL_DMS_CONTAINER=<dms-container-name>
MAIL_USE_SSH=true

# MAIL ACCOUNT LIST CACHE (Redis, read-through, invalidated on account creation)
MAIL_ACCOUNTS_CACHE_ENABLED=true
# A.SPEC 0006: 300 s. Mas ancho que el staleTime del frontend (60 s), para que el refetch
# periodico lo responda Redis y no un viaje al mail server. Los buzones creados desde la app
# actualizan el cache al instante; este TTL solo acota cuanto tarda en verse un cambio hecho
# por fuera de la app.
MAIL_ACCOUNTS_CACHE_TTL=300
# A.SPEC 0038: stale-while-revalidate. Pasado el TTL, la lista se responde desde Redis y se
# refresca en segundo plano, asi que la visita no espera al mail server. STALE_TTL es el
# limite duro de antiguedad que se acepta servir; mas viejo que eso, se consulta en linea.
# SWR=false recupera el comportamiento anterior (bloquear al expirar).
MAIL_ACCOUNTS_CACHE_STALE_TTL=86400
MAIL_ACCOUNTS_CACHE_SWR=true
# A.SPEC 0039: de donde sale la lista de buzones. "auto" lee el archivo de cuentas de DMS
# de una sola vez y cae a `setup email list` si el archivo no existe. "setup" fuerza el
# comando viejo (necesario con ACCOUNT_PROVISIONER=LDAP). "file" nunca cae al comando viejo.
MAIL_ACCOUNTS_SOURCE=auto

# Solo aplica con MAIL_USE_SSH=true. Reutiliza la sesion SSH entre llamadas en vez de
# abrir una por operacion. Vacio = desactivado (comportamiento de siempre). El directorio
# del socket lo crea la app en modo 0700; si no puede, degrada sin fallar.
# OJO: con MAIL_USE_SSH=false (docker exec local) esto no tiene efecto.
MAIL_SSH_CONTROL_PATH=
MAIL_SSH_CONTROL_PERSIST=60
