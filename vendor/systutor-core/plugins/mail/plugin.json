{
  "id": "mail",
  "name": "Mail Administration",
  "version": "0.1.0",
  "api_version": "1",
  "requires": [],
  "backend_entrypoint": "backend.register:register",
  "frontend_entrypoint": "frontend/register.ts",
  "permissions": [
    "mail.accounts.read",
    "mail.accounts.all",
    "mail.accounts.create",
    "mail.account.password",
    "mail.certificates.read",
    "mail.certificates.manage"
  ],
  "tenant_admin_permissions": [
    "mail.accounts.read",
    "mail.accounts.create",
    "mail.account.password",
    "mail.certificates.read"
  ],
  "events": [
    "mail.account.created",
    "mail.account.password_changed",
    "mail.certificate.requested",
    "mail.certificate.refreshed"
  ],
  "description": "Mail account management and TLS certificate inventory via Docker Mailserver"
}
