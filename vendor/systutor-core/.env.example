# Copy to .env and adjust values
SYSTUTOR_APP_NAME=SYSTUTOR API
SYSTUTOR_ENV=local
SYSTUTOR_DEBUG=true
SYSTUTOR_VERSION=0.1.0
SYSTUTOR_API_PREFIX=/api/v1
SYSTUTOR_LOG_LEVEL=INFO
SYSTUTOR_DATABASE_URL=postgresql+psycopg://<db-user>:<db-password>@localhost:5432/<db-name>
SYSTUTOR_REDIS_URL=redis://localhost:6379/0
SYSTUTOR_JWT_SECRET_KEY=<replace-with-random-secret>
SYSTUTOR_JWT_ACCESS_TOKEN_TTL_MINUTES=60
SYSTUTOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SYSTUTOR_PLUGINS_DIR=/absolute/path/to/plugins
SYSTUTOR_OUTBOX_DISPATCH_BATCH_SIZE=100
SYSTUTOR_OUTBOX_MAX_RETRIES=3
SYSTUTOR_SEED_ADMIN_EMAIL=<admin-email>
SYSTUTOR_SEED_ADMIN_PASSWORD=<admin-password>
SYSTUTOR_SEED_ADMIN_FULL_NAME=System Admin

# Hosting plugin (WordPress sites). The sites dir must be writable by the SSH
# user; /opt/spanel/sites needs root, use a home path when the user cannot sudo.
# SPANEL_DOCKER_TRANSPORT=ssh
# SPANEL_DOCKER_SSH_HOST=<docker-host>
# SPANEL_DOCKER_SSH_USER=<user>
# SPANEL_DOCKER_SSH_PORT=22
# SPANEL_HOSTING_NETWORK=proxy
# SPANEL_HOSTING_SITES_DIR=/opt/spanel/sites
