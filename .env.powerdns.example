# Host-side PowerDNS deployment settings. Copy to .env.powerdns and adjust the
# absolute key path. The key value itself never belongs in an environment file.
SPANEL_PDNS_API_URL=http://spanel-powerdns-lab-auth:8081
SPANEL_PDNS_API_KEY_PATH=/absolute/path/to/powerdns-lab/api-key
SPANEL_PDNS_SERVER_ID=localhost
SPANEL_PDNS_TIMEOUT_SECONDS=5
