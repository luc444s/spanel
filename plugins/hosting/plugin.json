{
  "id": "hosting",
  "name": "Hosting",
  "version": "0.1.0",
  "api_version": "1",
  "requires": [
    "docker_infra"
  ],
  "backend_entrypoint": "backend.plugin:register",
  "frontend_entrypoint": "frontend/register.tsx",
  "permissions": [
    "hosting.sites.read",
    "hosting.sites.adopt",
    "hosting.sites.provision",
    "hosting.sites.update",
    "hosting.sites.delete",
    "hosting.runtime.read",
    "hosting.runtime.manage",
    "hosting.access.read",
    "hosting.backups.read",
    "hosting.backups.create",
    "hosting.files.manage",
    "hosting.sso.create"
  ],
  "events": [
    "hosting.site.adopted"
  ],
  "description": "Gestor de sitios web sobre Docker remoto"
}
