# ============================================
# Spanel — Variables de entorno
# ============================================
# Copiar a .env y configurar para cada entorno.
# vendor/systutor-core/.env carga estas variables.
# ============================================

# ── Modo de operación ──────────────────────────
# "tailscale" = desarrollo (acceso via red Tailscale)
# "production" = VPS con dominios públicos
SPANEL_MODE=production

# ── API Spanel ─────────────────────────────────
# URL donde el API Spanel es accesible desde containers Docker.
# Usado por forwardAuth en Traefik.
#
# Tailscale:      http://<tailscale-ip>:8001
# VPS production: http://host.docker.internal:8001
#   (requiere --add-host=host.docker.internal:host-gateway en Docker)
SPANEL_API_URL=http://host.docker.internal:8001

# ── Docker remoto (via Tailscale SSH) ──────────
SPANEL_DOCKER_SSH_USER=lucas
SPANEL_DOCKER_SSH_HOST=100.67.5.50
SPANEL_DOCKER_SSH_PORT=22
SPANEL_DOCKER_SSH_PASSWORD=

# ── SSO WordPress ──────────────────────────────
# Secret compartido para JWT SSO entre Spanel y WordPress.
# Debe coincidir con el archivo spanel-sso-secret.txt en cada WP.
SPANEL_SSO_SECRET=spanel-sso-dev-shared-secret

# ── Kernel (systutor-core) ─────────────────────
# Producción: cambiar TODOS estos secretos por valores reales.
# Compose usa DB_PASSWORD para crear PostgreSQL y la URL para que la API conecte.

# Database
DB_PASSWORD=spanel-change-me
SYSTUTOR_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/spanel

# Redis
SYSTUTOR_REDIS_URL=redis://localhost:6379/0

# JWT
SYSTUTOR_JWT_SECRET_KEY=change-me-in-production
SYSTUTOR_JWT_ACCESS_TOKEN_TTL_MINUTES=60

# App
SYSTUTOR_APP_NAME=Spanel
SYSTUTOR_ENV=local
SYSTUTOR_DEBUG=false
SYSTUTOR_LOG_LEVEL=INFO
SYSTUTOR_API_PREFIX=/api/v1

# Seed (solo primera vez)
SYSTUTOR_SEED_ADMIN_EMAIL=admin@example.com
SYSTUTOR_SEED_ADMIN_PASSWORD=ChangeMe123!
SYSTUTOR_SEED_ADMIN_FULL_NAME=System Admin
SYSTUTOR_SEED_TENANT_NAME=Demo Tenant
SYSTUTOR_SEED_TENANT_SLUG=demo
SYSTUTOR_SEED_BRANCH_NAME=Main Branch
SYSTUTOR_SEED_BRANCH_CODE=MAIN

# ── Frontend ───────────────────────────────────
# Puerto del frontend Vite (default: 5175)
# VITE_PORT=5175

# CORS opcional para Docker/dev
# SYSTUTOR_CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
