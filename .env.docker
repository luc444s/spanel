SYSTUTOR_JWT_SECRET_KEY=change-me-to-a-real-secret
SYSTUTOR_JWT_ACCESS_TOKEN_TTL_MINUTES=60
SYSTUTOR_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

