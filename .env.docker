SYSTUTOR_ENV=production
SYSTUTOR_DEBUG=false
SYSTUTOR_VERSION=0.1.0
SYSTUTOR_API_PREFIX=/api/v1
SYSTUTOR_LOG_LEVEL=INFO
SYSTUTOR_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/sysadmin
SYSTUTOR_REDIS_URL=redis://redis:6379/0
SYSTUTOR_OUTBOX_DISPATCH_BATCH_SIZE=100
